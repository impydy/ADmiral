<Project Sdk="Microsoft.NET.Sdk">

  <!-- ADmiral.exe: the desktop window (WinForms + WebView2) and, started with \-\-retry-service, the Windows service host.
       Release build (Windows or Linux):
         dotnet publish src/ADmiral.Desktop -c Release -r win-x64 \-\-self-contained
       -> src/ADmiral.Desktop/bin/Release/net10.0-windows/win-x64/publish/ (one folder; packaging/installer.iss installs it) -->

  <ItemGroup>
    <ProjectReference Include="..\ADmiral.Core\ADmiral.Core.csproj" />
    <ProjectReference Include="..\ADmiral.Web\ADmiral.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ADmiral</AssemblyName>
    <RootNamespace>ADmiral.Desktop</RootNamespace>
    <!-- version resource (replaces packaging/version_info.txt); Version comes from Directory.Build.props -->
    <AssemblyTitle>ADmiral</AssemblyTitle>
    <Description>ADmiral</Description>
    <Copyright>TidecrestLabs</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>..\ADmiral.Web\wwwroot\admiral.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <!-- English + Hungarian satellite resources only -->
    <SatelliteResourceLanguages>en;hu</SatelliteResourceLanguages>
    <!-- one folder, no self-extracting single file: antivirus ML engines flag those as false positives -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <!-- no .pdb / .xml of the referenced projects and packages in the release folder -->
    <AllowedReferenceRelatedFileExtensions>-</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <!-- The UI files (src/ADmiral.Web/wwwroot) next to ADmiral.exe; passed to the web layer as StaticRoot. A Copy task
       (not Content items) so this never collides with whatever the web project itself copies. -->
  <ItemGroup>
    <AdmiralWebRoot Include="..\ADmiral.Web\wwwroot\**\*" />
  </ItemGroup>
  <!-- WinForms only: drop the package's WPF wrapper (it drags in a conflicting WindowsBase reference) -->
  <Target Name="AdmiralDropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
  <Target Name="AdmiralCopyWebRoot" AfterTargets="Build">
    <Copy SourceFiles="@(AdmiralWebRoot)" DestinationFiles="@(AdmiralWebRoot->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="AdmiralPublishWebRoot" AfterTargets="Publish">
    <Copy SourceFiles="@(AdmiralWebRoot)" DestinationFiles="@(AdmiralWebRoot->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
