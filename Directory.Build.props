<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>0.7.0</Version>
    <Company>ADmiral</Company>
    <Product>ADmiral</Product>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1848;CA1305;CA1310;CA1307;CA1309;CA2254;CA1862;CA1716;CA1720;CA1711;CA1031;CA1051;CA1062;CA1303;CA1304;CA1311;CA1819;CA1002;CA1056;CA1054;CA1055;CA2227;CA1308;CA1032;CA1064;CA1724;CA1725;CA1806;CA1822;CA1859;CA1860;CA1861;CA1865;CA1866;CA1867;CA2201;CA5394;CA1050;CA1707;CA1515;CA1812;CA1849;CA2007;CA1863</NoWarn>
  </PropertyGroup>
</Project>
